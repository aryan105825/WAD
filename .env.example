# Copy to .env and fill in. .env is git-ignored.

# Read only by scripts/hour0_smoke.sh (Featherless is the Breaker's model provider)
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# Set to a model id available on your Featherless account (must be a different family from the Builder)
FEATHERLESS_MODEL=

# Read only by factory/lib/common.py:load_config() (validated at startup)
FACTORY_DRIVER_IMAGE=python:3.12.7-slim
FACTORY_CPUS=1
FACTORY_MEMORY=512m
FACTORY_START_TIMEOUT=30
FACTORY_MAX_REWORK=3
FACTORY_BUILD_CACHE=0

# BASE_URL and SEED are set per run by the gate for check scripts (read only in factory/lib/hammer.py); do not set them here.
# BAND: sign-in is through BAND Desktop; no BAND variables are required.
